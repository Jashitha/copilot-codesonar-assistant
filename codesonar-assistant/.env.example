# Copy this file to .env and fill your own values.
# Do not commit real secrets.

# Required for automatic Dashboard refresh/download
# CODESONAR_REPORT_URL should point to the CodeSonar report or CSV export endpoint,
# not the sign-in page. The workflow will try to download CSV data from this URL.
CODESONAR_REPORT_URL=
CODESONAR_USERNAME=
CODESONAR_PASSWORD=

# Optional auth alternatives
# CODESONAR_COOKIE=
# CODESONAR_TOKEN=

# Optional workflow options
# Lines starting with "#" are disabled placeholders — remove the leading "#" and
# replace the example names with real owner/reviewer names to activate assignment.
# New issues are split evenly across the pool (round-robin) and shown as
# owner/reviewer columns in Master_Tracker.xlsx and in the Dashboard output.
 CODESONAR_OWNERS=
 CODESONAR_REVIEWERS=
 CODESONAR_INSECURE=false

# ---------------------------------------------------------------------------
# Gerrit Integration (gerrit_hook.py)
# ---------------------------------------------------------------------------
# Required to enable automatic pre-commit review on Gerrit patch sets.
# The hook posts inline comments and a Verified vote on every patchset-created
# event. Vote: Verified -1 if any HIGH severity finding, +1 if clean.
# GERRIT_URL should be the Gerrit server base URL used by the review hook,
# not a change URL. It is the root endpoint the hook uses to call the Gerrit
# REST API and post review votes.

GERRIT_URL=
GERRIT_USER=
GERRIT_HTTP_PASSWORD=

# SSH settings for gerrit_event_listener.py
GERRIT_SSH_HOST=
GERRIT_SSH_PORT=29418
GERRIT_SSH_KEY=~/.ssh/id_rsa

# ---------------------------------------------------------------------------
# Daily Email Reports
# ---------------------------------------------------------------------------
# Set EMAIL_ENABLED=true only when SMTP configuration is ready.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
EMAIL_CC=
EMAIL_BCC=

# Optional owner-specific emails. JSON object mapping owner names to addresses.
OWNER_EMAILS_JSON=

# Optional quick-link configuration for the generated email.
EMAIL_DASHBOARD_URL=
EMAIL_MASTER_TRACKER_URL=
EMAIL_HB_PRIO_1_URL=

