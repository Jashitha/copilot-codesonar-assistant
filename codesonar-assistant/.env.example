# Copy this file to .env and fill your own values.
# Do not commit real secrets.

# Required for automatic Dashboard refresh/download
CODESONAR_REPORT_URL=https://codesonar.example.com/report.csv
CODESONAR_USERNAME=your-username
CODESONAR_PASSWORD=your-password

# Optional auth alternatives
# CODESONAR_COOKIE=
# CODESONAR_TOKEN=

# Optional workflow options
# Use semicolon-separated names for tracker ownership.
CODESONAR_OWNERS=
CODESONAR_REVIEWERS=
CODESONAR_INSECURE=false

# ---------------------------------------------------------------------------
# Gerrit Integration (gerrit_hook.py)
# ---------------------------------------------------------------------------
GERRIT_URL=
GERRIT_USER=
GERRIT_HTTP_PASSWORD=

# SSH settings for gerrit_event_listener.py
GERRIT_SSH_HOST=
GERRIT_SSH_PORT=29418
GERRIT_SSH_KEY=~/.ssh/id_rsa

# ---------------------------------------------------------------------------
# Daily Email Reports
# ---------------------------------------------------------------------------
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true
EMAIL_FROM=codesonar@example.com
EMAIL_OWNERS=
EMAIL_CC=

# Optional quick-link configuration for the generated email.
EMAIL_DASHBOARD_URL=
EMAIL_MASTER_TRACKER_URL=
EMAIL_HB_PRIO_1_URL=
